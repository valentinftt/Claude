---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props { title: string; description?: string }
const { title, description = "Sonny's Fahrschule in Kulmbach – schnell, individuell und zuverlässig zum Führerschein. Klassen B, BF17, BE und B96." } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Home' ? site.name : `${title} – ${site.name}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#a00018" />
    <link rel="icon" href="/img/logo.png" />
    <ClientRouter />
    <noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    <header class="hdr" id="hdr">
      <div class="wrap hdr-in">
        <a href="/" class="brand" aria-label="Startseite"><img src="/img/logo.png" alt="Sonny's Fahrschule" width="587" height="305" /></a>
        <nav class="nav" id="nav" aria-label="Hauptmenü">
          {nav.map((item) => (
            <div class={`ni ${item.children ? 'has-sub' : ''}`}>
              <a href={item.href} class={isActive(item.href) ? 'on' : ''}>{item.label}</a>
              {item.children && (
                <div class="sub">
                  {item.children.map((c) => <a href={c.href} class={isActive(c.href) ? 'on' : ''}>{c.label}</a>)}
                </div>
              )}
            </div>
          ))}
        </nav>
        <a href={site.phoneHref} class="hdr-call"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span>{site.phone}</span></a>
        <button class="burger" id="burger" aria-label="Menü öffnen" aria-expanded="false"><i></i><i></i><i></i></button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="ftr">
      <div class="road" aria-hidden="true"></div>
      <div class="wrap ftr-grid">
        <div>
          <img src="/img/logo.png" alt="Sonny's Fahrschule" class="ftr-logo" />
          <p class="muted">Schnell, individuell und zuverlässig zum Führerschein.</p>
        </div>
        <div>
          <h4>Kontakt</h4>
          <p>{site.name}<br />{site.street}<br />{site.city}</p>
          <p><a href={site.phoneHref}>Tel.: {site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <h4>Bürozeiten</h4>
          <p>{site.hours}</p>
          <a class="btn yellow" href="/kontakt/">Anfrage senden</a>
        </div>
      </div>
      <div class="wrap ftr-legal">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <nav><a href="/impressum/">Impressum</a> | <a href="/datenschutz/">Datenschutz</a> | <a href="/sitemap/">Sitemap</a></nav>
      </div>
    </footer>

    <div class="fab" aria-label="Schnellkontakt">
      <a href={site.whatsapp} target="_blank" rel="noopener" class="fab-wa" aria-label="WhatsApp schreiben">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
        <span>WhatsApp</span>
      </a>
      <a href={site.phoneHref} class="fab-call" aria-label="Anrufen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        <span>Anrufen</span>
      </a>
    </div>

    <script>
      function init() {
        const hdr = document.getElementById('hdr');
        const onScroll = () => hdr?.classList.toggle('small', window.scrollY > 40);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        const burger = document.getElementById('burger');
        burger?.addEventListener('click', () => {
          const open = document.body.classList.toggle('menu-open');
          burger.setAttribute('aria-expanded', String(open));
        });
        document.querySelectorAll('#nav a').forEach((a) => a.addEventListener('click', () => document.body.classList.remove('menu-open')));

        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', init);
    </script>

    <style>
      .hdr { position: fixed; inset: 0 0 auto; z-index: 50; transition: background 0.35s, box-shadow 0.35s, padding 0.35s; padding: 18px 0; }
      .hdr.small, :global(body.light-head) .hdr { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(14px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); padding: 8px 0; }
      .hdr-in { display: flex; align-items: center; gap: 24px; }
      .brand { flex: none; background: #fff; border-radius: 14px; padding: 6px 10px; box-shadow: 0 8px 24px rgba(0,0,0,.15); transition: transform .3s; }
      .brand:hover { transform: rotate(-2deg) scale(1.03); }
      .brand img { height: 58px; width: auto; transition: height 0.35s; }
      .hdr.small .brand img { height: 46px; }
      .hdr.small .brand { box-shadow: none; }
      .nav { display: flex; gap: 2px; margin-left: auto; }
      .ni { position: relative; }
      .ni > a { display: block; padding: 10px 11px; font-family: var(--head); font-weight: 700; font-size: 19px; letter-spacing: 0.04em; text-transform: uppercase; color: #fff; text-decoration: none; position: relative; }
      .hdr.small .ni > a { color: var(--ink); }
      .ni > a::after { content: ''; position: absolute; left: 11px; right: 11px; bottom: 4px; height: 3px; border-radius: 2px; background: var(--yellow); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
      .ni > a:hover::after, .ni > a.on::after { transform: scaleX(1); }
      .hdr.small .ni > a::after { background: var(--red); }
      .sub { position: absolute; top: 100%; left: 0; min-width: 190px; padding: 10px; border-radius: 16px; background: #fff; box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(10px); transition: 0.25s; }
      .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
      .sub a { display: block; padding: 10px 14px; border-radius: 10px; color: var(--ink); text-decoration: none; font-weight: 600; }
      .sub a:hover, .sub a.on { background: var(--soft); color: var(--red); }
      .hdr-call { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px; background: var(--red); color: #fff; text-decoration: none; font-weight: 700; white-space: nowrap; }
      .hdr-call svg { width: 18px; height: 18px; }
      .burger { display: none; margin-left: auto; width: 50px; height: 50px; border-radius: 14px; border: 0; background: var(--red); cursor: pointer; padding: 14px 12px; flex-direction: column; justify-content: space-between; }
      .burger i { display: block; height: 3px; border-radius: 2px; background: #fff; transition: 0.3s; }
      :global(body.menu-open) .burger i:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
      :global(body.menu-open) .burger i:nth-child(2) { opacity: 0; }
      :global(body.menu-open) .burger i:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }
      @media (max-width: 1180px) {
        .hdr-call span { display: none; }
        .hdr-call { padding: 12px; }
      }
      @media (max-width: 1060px) {
        .burger { display: flex; }
        .hdr-call { display: none; }
        .nav { position: fixed; inset: 0; z-index: -1; flex-direction: column; justify-content: center; align-items: center; gap: 4px; background: var(--asphalt); clip-path: circle(0 at calc(100% - 40px) 40px); transition: clip-path 0.6s cubic-bezier(.7,0,.2,1); }
        :global(body.menu-open) .nav { clip-path: circle(150% at calc(100% - 40px) 40px); }
        .ni > a, .hdr.small .ni > a { color: #fff; font-size: 30px; text-align: center; }
        .sub { position: static; opacity: 1; visibility: visible; transform: none; background: transparent; box-shadow: none; display: flex; gap: 6px; justify-content: center; padding: 0 0 6px; }
        .sub a { color: var(--yellow); padding: 4px 10px; }
      }
      .ftr { background: #18181a; color: rgba(255, 255, 255, 0.85); }
      .ftr-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 40px; padding: 70px 0 40px; }
      .ftr-logo { width: 220px; background: #fff; border-radius: 16px; padding: 10px; margin-bottom: 16px; }
      .ftr h4 { font-family: var(--head); font-size: 24px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--yellow); margin: 0 0 12px; }
      .ftr a { color: #fff; }
      .muted { color: rgba(255, 255, 255, 0.6); }
      .ftr-legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 22px 0 110px; border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 15px; color: rgba(255, 255, 255, 0.55); }
      .ftr-legal a { color: rgba(255, 255, 255, 0.8); text-decoration: none; }
      @media (max-width: 820px) { .ftr-grid { grid-template-columns: 1fr; } }
      .fab { position: fixed; right: 18px; bottom: 18px; z-index: 60; display: flex; flex-direction: column; gap: 12px; }
      .fab a { position: relative; display: flex; align-items: center; justify-content: center; width: 62px; height: 62px; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25); transition: transform 0.25s, width 0.3s, border-radius .3s; }
      .fab a svg { width: 28px; height: 28px; flex: none; }
      .fab a span { max-width: 0; overflow: hidden; white-space: nowrap; font-weight: 700; transition: max-width 0.3s, margin 0.3s; }
      .fab a:hover { width: 170px; border-radius: 31px; }
      .fab a:hover span { max-width: 100px; margin-left: 10px; }
      .fab-wa { background: #25d366; }
      .fab-call { background: var(--red); }
      .fab-call::before { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgba(160, 0, 24, 0.6); animation: ping 2.2s infinite; }
      @keyframes ping { 70% { box-shadow: 0 0 0 18px rgba(160, 0, 24, 0); } 100% { box-shadow: 0 0 0 0 rgba(160, 0, 24, 0); } }
    </style>
  </body>
</html>
