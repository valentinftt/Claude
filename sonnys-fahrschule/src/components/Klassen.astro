---
import { klassen } from '../data/site';
---
<div class="kl">
  {klassen.map((k, i) => (
    <a href={k.href} class="kl-card card reveal" style={`--d:${i * 0.08}s`}>
      <div class="kl-img"><img src={k.img} alt={`Klasse ${k.code}`} loading="lazy" /></div>
      <div class="kl-body">
        <h3>{k.code}</h3>
        <p>{k.short}</p>
        <span class="kl-more">Mehr Informationen <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </div>
    </a>
  ))}
</div>
<style>
  .kl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  @media (max-width: 1000px) { .kl { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .kl { grid-template-columns: 1fr; } }
  .kl-card { display: block; overflow: hidden; color: inherit; text-decoration: none; }
  .kl-img { position: relative; background: var(--yellow); aspect-ratio: 370 / 217; overflow: hidden; }
  .kl-img::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 10px; background: repeating-linear-gradient(90deg, var(--ink) 0 22px, var(--yellow) 22px 44px); opacity: .85; }
  .kl-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
  .kl-card:hover .kl-img img { transform: translateX(14px) scale(1.06); }
  .kl-body { padding: 22px 24px 26px; }
  .kl-body h3 { font-size: 52px; color: var(--red); }
  .kl-body p { color: var(--grey); font-weight: 500; margin: 6px 0 14px; }
  .kl-more { display: inline-flex; align-items: center; gap: 8px; font-family: var(--head); font-weight: 700; font-size: 19px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink); }
  .kl-more svg { width: 20px; height: 20px; transition: transform 0.25s; }
  .kl-card:hover .kl-more { color: var(--red); }
  .kl-card:hover .kl-more svg { transform: translateX(5px); }
</style>
