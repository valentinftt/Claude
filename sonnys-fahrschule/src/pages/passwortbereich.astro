---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Passwortbereich">
  <PageHead title="Passwortbereich" eyebrow="Geschützter Bereich" crumbs={[{ href: '', label: 'Passwortbereich' }]} />
  <section class="section">
    <div class="wrap">
      <div class="pw card reveal zoom">
        <div class="pw-lock">🔒</div>
        <h2>Geschützter Bereich</h2>
        <p>Dieser Bereich ist nur mit einem Passwort zugänglich.</p>
        <form class="pw-f" onsubmit="event.preventDefault()">
          <label for="pw">Passwort:</label>
          <input id="pw" type="password" autocomplete="current-password" />
          <button class="btn" type="submit">Login</button>
        </form>
      </div>
    </div>
  </section>
  <style>
    .pw { max-width: 560px; margin: 0 auto; padding: 50px 40px; text-align: center; }
    .pw-lock { font-size: 60px; animation: sh 3s ease-in-out infinite; }
    @keyframes sh { 0%, 80%, 100% { transform: rotate(0); } 85% { transform: rotate(-12deg); } 90% { transform: rotate(10deg); } 95% { transform: rotate(-6deg); } }
    .pw h2 { font-size: 44px; margin: 10px 0; }
    .pw-f { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; text-align: left; }
    .pw-f label { font-weight: 700; }
    .pw-f input { padding: 16px 18px; border-radius: 14px; border: 2px solid #e4e4e0; font: inherit; }
    .pw-f input:focus { outline: 0; border-color: var(--red); }
    .pw-f .btn { justify-content: center; }
  </style>
</Base>
