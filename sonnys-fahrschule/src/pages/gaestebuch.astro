---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import entries from '../data/gaestebuch.json';
import { site } from '../data/site';
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Gästebuch-Eintrag')}&body=${encodeURIComponent('Name:\n\nMein Eintrag:\n')}`;
---
<Base title="Gästebuch">
  <PageHead title="Gästebuch" eyebrow={`Kommentare: ${entries.length}`} text="Das sagen meine Fahrschülerinnen und Fahrschüler." crumbs={[{ href: '', label: 'Gästebuch' }]} />
  <section class="section soft">
    <div class="wrap">
      <div class="gb-top reveal"><a class="btn" href={mail}>Eintrag schreiben</a></div>
      <div class="gb">
        {entries.map((e, i) => (
          <article class="gb-e card reveal" style={`--d:${(i % 3) * 0.08}s`}>
            <div class="gb-h"><span class="gb-av">{e.name.charAt(0)}</span><div><b>{e.name}</b><span>{e.date}</span></div><em>#{e.nr}</em></div>
            <p>{e.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <style>
    .gb-top { display: flex; justify-content: flex-end; margin-bottom: 30px; }
    .gb { columns: 3 340px; column-gap: 22px; }
    .gb-e { break-inside: avoid; margin-bottom: 22px; padding: 26px; }
    .gb-h { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
    .gb-av { width: 50px; height: 50px; flex: none; border-radius: 50%; background: var(--red); color: #fff; display: flex; align-items: center; justify-content: center; font-family: var(--head); font-weight: 800; font-size: 26px; }
    .gb-h b { display: block; font-size: 19px; }
    .gb-h span { font-size: 14px; color: var(--grey); }
    .gb-h em { margin-left: auto; font-style: normal; font-family: var(--head); font-weight: 800; font-size: 22px; color: var(--yellow); -webkit-text-stroke: 1px var(--ink); }
    .gb-e p { margin: 0; font-size: 17px; }
  </style>
</Base>
